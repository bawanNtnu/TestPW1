---
import SiteLayout from '../../layouts/SiteLayout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('articles',({data})=>!data.draft)).map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props;
const {Content,headings}=await render(entry);
const entries=(await getCollection('articles')).sort((a,b)=>a.data.order-b.data.order);
const base=import.meta.env.BASE_URL;
const next=entries.find(e=>e.data.order===entry.data.order+1);
---
<SiteLayout title={entry.data.title} description={entry.data.description} article><div class="article-heading narrow"><a class="text-link" href={base+'articles/'}>← 全部筆記</a><p class="eyebrow">FIELD NOTE / 0{entry.data.order} · {entry.data.tags.join(' / ')}</p><h1>{entry.data.title}</h1><p class="deck">{entry.data.description}</p><p class="fine">2026.10.10 · AI 原創 QA 文章 · 情境為示例，非真實採訪</p></div><div class="article-layout narrow"><aside class="article-toc"><nav aria-label="文章段落"><p class="eyebrow">本篇索引</p><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol></nav><p class="toc-note">讀完不必記得全部。帶走一個問題，出門試一次就好。</p></aside><article class="prose"><Content/><aside class="practice-box"><p class="eyebrow">帶走一個練習</p><p>{entry.data.exercise}</p></aside><nav class="next-reading" aria-label="接續閱讀">{next?<><p class="eyebrow">下一篇 / 0{next.data.order}</p><a href={base+'articles/'+next.id+'/'}>{next.data.title} ↗</a></>:<><p class="eyebrow">完成本期閱讀</p><a href={base+'topics/'}>從主題重看三篇筆記 ↗</a></>}</nav></article></div></SiteLayout>
