---
import config from '../../site.config.json';
import SiteNavigation from '../components/SiteNavigation.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const {title,description=config.brand.tagline,article=false}=Astro.props;
const base=import.meta.env.BASE_URL;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
const fullTitle=title===config.brand.name?title:`${title}｜步幅`;
const path=Astro.url.pathname;
const inner=path!==base&&!/\/404(?:\.html)?\/?$/.test(path);
const crumbs=[{label:'首頁',href:base},...(article?[{label:'文章',href:base+'articles/'}]:path===base+'review-notes/'?[{label:'城市散步工具箱',href:base+'toolbox/'}]:[]),{label:title}];
---
<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{fullTitle}</title><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><link rel="canonical" href={canonical}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="zh_TW"/><link rel="icon" type="image/svg+xml" href={base+'favicon.svg'}/><link rel="alternate" type="application/rss+xml" title="步幅文章 RSS" href={base+'rss.xml'}/><link rel="stylesheet" href={base+'site.css'}/></head>
<body><a class="skip" href="#main">跳到主要內容</a><div class="test-strip">公開 QA 測試作品 · 虛構編輯品牌 · 不提供商業服務</div><header class="site-header"><a class="brand" href={base}><strong>步幅<span>。</span></strong><small>城市慢行筆記 / FIELD NOTES</small></a><SiteNavigation/></header><main id="main" tabindex="-1">{inner&&<Breadcrumbs items={crumbs}/>}<slot/></main><footer class="site-footer"><div><a class="footer-brand" href={base}>步幅｜城市慢行筆記</a><p>從一段短路開始，重新看見每天經過的城市。</p></div><div class="footer-links"><a href={base+'start-here/'}>開始閱讀</a><a href={base+'toolbox/'}>城市散步工具箱</a><a href={base+'review-notes/'}>筆記回看</a><a href={base+'about/#statement'}>測試與隱私聲明</a><a href={base+'rss.xml'}>RSS</a></div><p class="fine">© 2026 步幅 · AI 原創測試內容。無訂閱、預約或資料收集表單。</p></footer></body></html>
